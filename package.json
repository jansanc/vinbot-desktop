{
  "name": "vinbot-desktop-authenticator",
  "version": "1.1.0",
  "description": "Desktop app to extract and manage Vinted session authentication",
  "main": "public/electron.js",
  "author": "Pol",
  "license": "MIT",
  "scripts": {
    "compile:main": "tsc --skipLibCheck",
    "renderer:dev": "vite",
    "renderer:build": "vite build",
    "typecheck": "tsc --noEmit -p . && tsc -p cli",
    "test": "vitest run",
    "electron-dev": "node dev-start.js",
    "electron-build": "npm run clean && npm run compile:main && npm run renderer:build && electron-builder --publish never",
    "build": "npm run renderer:build",
    "start": "npm run electron-dev",
    "extract:vinted:firefox": "ts-node cli/vinted-firefox.ts",
    "clean": "node -e \"for (const d of ['dist','build','dist-app']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "dist": "npm run electron-build",
    "dist:win": "npm run electron-build -- --win -c.electronDist=node_modules/electron/dist",
    "dist:mac": "npm run electron-build -- --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.vinbot.authenticator",
    "productName": "Vinbot Authenticator",
    "copyright": "Copyright © 2026 Vinbot",
    "extends": null,
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "en-GB",
      "es",
      "es-419",
      "ca",
      "fr"
    ],
    "afterPack": "build-resources/after-pack.js",
    "files": [
      "public/electron.js",
      "public/preload.js",
      "public/favicon.png",
      "build/**/*",
      "!build/electron.js",
      "!build/preload.js",
      "!build/**/*.map",
      "dist/**/*.js",
      "!dist/**/*.map",
      "!dist/**/*.test.js",
      "!node_modules/sql.js/dist/{sql-asm*,sql-wasm-debug*,sql-wasm-browser*,worker.*}",
      "!node_modules/sql.js/{.devcontainer,*.md,*.svg,*.js,*.cjs,*.json}",
      "node_modules/sql.js/package.json",
      "package.json"
    ],
    "directories": {
      "buildResources": "build-resources",
      "output": "dist-app"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jansanc",
        "repo": "vinbot-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vinbot Authenticator",
      "artifactName": "Vinbot-Authenticator-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Vinbot-Authenticator-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "public/favicon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Vinbot Authenticator asks the Firefox login window it opened to quit, so your session is saved."
      },
      "artifactName": "Vinbot-Authenticator-${version}-mac.${ext}"
    }
  }
}
