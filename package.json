{
  "name": "vinbot-desktop-authenticator",
  "version": "1.0.0",
  "description": "Desktop app to extract and manage Vinted session authentication",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "Pol",
  "license": "MIT",
  "scripts": {
    "compile:main": "tsc --skipLibCheck",
    "css:watch": "npx @tailwindcss/cli -i input.css -o public/output.css --watch",
    "css:build": "npx @tailwindcss/cli -i input.css -o public/output.css",
    "react-start": "craco start",
    "react-build": "npm run css:build && craco build",
    "react-test": "craco test",
    "react-eject": "react-scripts eject",
    "electron-dev": "npm run compile:main && concurrently \"npm run css:watch\" \"cross-env PORT=3002 npm run react-start\" \"wait-on http://localhost:3002 && cross-env ELECTRON_DEV=true electron .\"",
    "electron-build": "npm run compile:main && npm run react-build && electron-builder",
    "build": "npm run react-build",
    "start": "npm run electron-dev",
    "extract:vinted:firefox": "ts-node src/cli/vinted-firefox.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.5.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^25.1.1",
    "electron-is-dev": "^2.0.0",
    "postcss": "^8.5.15",
    "react-scripts": "5.0.1",
    "tailwindcss": "^4.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.vinted.authenticator",
    "productName": "Vinted Authenticator",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "public/**/*"
    ],
    "directories": {
      "buildResources": "public",
      "output": "dist-app"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
