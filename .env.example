# ============================================
# Vinted API Configuration
# ============================================
# Point this to your vinted-api server (default port 3001)
# The backend API handles all profile uploads to AWS S3
REACT_APP_API_URL=http://localhost:3001

# ============================================
# Profile Upload Flow
# ============================================
# When users upload browser profiles:
# 1. Profiles are compressed to tar.gz locally
# 2. Sent to backend at /api/v1/integrations/vinted/profile/upload
# 3. Backend uploads to AWS S3 and stores S3 path in database
# 4. No direct S3 access needed from desktop app
#
# AWS S3 Configuration (needed in backend .env):
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# AWS_S3_BUCKET=vinted-profiles
# AWS_S3_REGION=us-east-1

# ============================================
# Optional Settings
# ============================================
# API key if needed in the future
# REACT_APP_API_KEY=your_api_key_here
