# ============================================
# Vinted API Configuration
# ============================================
# Point this to your vinted-api server (default port 3001)
# The backend API handles all profile uploads to Supabase Storage
REACT_APP_API_URL=http://localhost:3001

# ============================================
# Profile Upload Flow
# ============================================
# When users upload browser profiles:
# 1. Profiles are compressed to tar.gz locally
# 2. Sent to the backend at /api/v1/vinted/auth/profile-upload
# 3. The backend stores them in the Supabase Storage "profiles" bucket and
#    records the bucket-relative path in vinted_accounts.profile_s3
# 4. The desktop app never touches object storage directly and holds no
#    storage credentials. It does not choose the storage path either - the
#    backend derives it from the user id and Vinted email.

# ============================================
# Cloudflare Turnstile (login)
# ============================================
# Overrides the site key built into src/config/config.ts (empty = use that
# one). Main process only; a packaged build reads no .env. Cloudflare's test
# key 1x00000000000000000000AA always passes, on any hostname, against the
# test secret 1x0000000000000000000000000000000AA.
VINBOT_TURNSTILE_SITE_KEY=
# Where the check page appears to live; its hostname must be allowed for the
# site key in the Cloudflare dashboard (empty = the web app's)
VINBOT_TURNSTILE_PAGE_URL=

# ============================================
# Optional Settings
# ============================================
# API key if needed in the future
# REACT_APP_API_KEY=your_api_key_here
